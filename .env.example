# Copy to .env and fill in. Names only here: never commit real values.

# Backend: where processed data and results live (default ./data)
TERRALENS_DATA_DIR=./data

# Backend: comma-separated origins allowed by CORS (add the deployed frontend URL)
TERRALENS_CORS_ORIGINS=http://localhost:5173

# Frontend (put in frontend/.env.local; Vite only exposes VITE_ variables): base URL of the API,
# or leave empty to read the static snapshot
VITE_API_BASE_URL=http://localhost:8000
