{
  // Cloudflare Workers Static Assets: serves the Vite build in ./dist.
  // not_found_handling makes every unknown route return index.html, which React Router needs.
  "name": "terralens",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
