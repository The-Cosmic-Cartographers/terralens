.env
.env.*
!.env.example
.netrc
*.pem

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node / Vite
node_modules/
dist/
frontend/.env*.local

# OS and editors
.DS_Store
.idea/
.vscode/
*.log
